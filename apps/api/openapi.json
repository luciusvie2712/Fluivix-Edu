            "type": "array",
            "items": { "$ref": "#/components/schemas/MembershipView" }
          },
          "activeTenantId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "activeRole": {
            "nullable": true,
            "allOf": [{ "$ref": "#/components/schemas/Role" }]
          }
        },
        "required": [
          "id",
          "displayName",
          "memberships",
          "activeTenantId",
          "activeRole"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/MeView" },
          "meta": { "$ref": "#/components/schemas/MetaDto" }
        },
        "required": ["data", "meta"]
      },
      "TenantsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MembershipView" }
          },
          "meta": { "$ref": "#/components/schemas/MetaDto" }
        },
        "required": ["data", "meta"]
      },
      "SessionView": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "createdAt", "expiresAt"]
      },
      "SessionsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SessionView" }
          },
          "meta": { "$ref": "#/components/schemas/MetaDto" }
        },
        "required": ["data", "meta"]
      },
      "InviteDto": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "academic_staff",
              "accountant",
              "teacher",
              "student",
              "guardian"
            ]
          }
        },
        "required": ["email", "role"]
      },
      "InviteView": {
        "type": "object",
        "properties": {
          "invitationId": { "type": "string", "format": "uuid" },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "required": ["invitationId", "expiresAt"]
      },
      "InviteResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/InviteView" },
          "meta": { "$ref": "#/components/schemas/MetaDto" }
        },
        "required": ["data", "meta"]
      },
      "StudentView": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "studentCode": { "type": "string" },
          "fullName": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "PAUSED", "GRADUATED", "INACTIVE"]
          }
        },
        "required": ["id", "studentCode", "fullName", "status"]
      },
      "PageView": {
        "type": "object",
        "properties": {
          "page": { "type": "number" },
          "limit": { "type": "number" },
          "total": { "type": "number" },
          "totalPages": { "type": "number" }
        },
        "required": ["page", "limit", "total", "totalPages"]
      },
      "StudentListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StudentView" }
          },
          "page": { "$ref": "#/components/schemas/PageView" },
          "meta": { "$ref": "#/components/schemas/MetaDto" }
        },
        "required": ["data", "page", "meta"]
      },
      "StudentResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/StudentView" },
          "meta": { "$ref": "#/components/schemas/MetaDto" }
        },
        "required": ["data", "meta"]
      },
      "CreateStudentDto": {
        "type": "object",
        "properties": {
          "studentCode": { "type": "string", "maxLength": 40 },
          "fullName": { "type": "string", "maxLength": 150 }
        },
        "required": ["studentCode", "fullName"]
      }
    }
  }
