  "info": {
    "title": "FluivixEdu API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": { "scheme": "bearer", "bearerFormat": "JWT", "type": "http" }
    },
    "schemas": {
      "ErrorView": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["code", "message"]
      },
      "MetaDto": {
        "type": "object",
        "properties": { "traceId": { "type": "string" } },
        "required": ["traceId"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorView" },
          "meta": { "$ref": "#/components/schemas/MetaDto" }
        },
        "required": ["error", "meta"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": { "type": "string", "minLength": 12, "maxLength": 128 }
        },
        "required": ["email", "password"]
      },
      "TokenDto": {
        "type": "object",
        "properties": { "accessToken": { "type": "string" } },
        "required": ["accessToken"]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/TokenDto" },
          "meta": { "$ref": "#/components/schemas/MetaDto" }
        },
        "required": ["data", "meta"]
      },
      "ResultDto": {
        "type": "object",
        "properties": { "revoked": { "type": "boolean" } },
        "required": ["revoked"]
      },
      "RevokeResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/ResultDto" },
          "meta": { "$ref": "#/components/schemas/MetaDto" }
        },
        "required": ["data", "meta"]
      },
      "ContextDto": {
        "type": "object",
        "properties": {
          "tenantId": { "type": "string", "format": "uuid" },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "academic_staff",
              "accountant",
              "teacher",
              "student",
              "guardian"
            ]
          }
        },
        "required": ["tenantId", "role"]
      },
      "ForgotDto": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 }
        },
        "required": ["email"]
      },
      "MessageDto": {
        "type": "object",
        "properties": { "message": { "type": "string" } },
        "required": ["message"]
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/MessageDto" },
          "meta": { "$ref": "#/components/schemas/MetaDto" }
        },
        "required": ["data", "meta"]
      },
      "ResetDto": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "minLength": 43, "maxLength": 43 },
          "password": { "type": "string", "minLength": 12, "maxLength": 128 }
        },
        "required": ["token", "password"]
      },
      "ResetResult": {
        "type": "object",
        "properties": { "reset": { "type": "boolean" } },
        "required": ["reset"]
      },
      "ResetResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/ResetResult" },
          "meta": { "$ref": "#/components/schemas/MetaDto" }
        },
        "required": ["data", "meta"]
      },
      "AcceptInvitationDto": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "minLength": 43, "maxLength": 43 },
          "password": { "type": "string", "minLength": 12, "maxLength": 128 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 150 }
        },
        "required": ["token", "password", "displayName"]
      },
      "ActivationResult": {
        "type": "object",
        "properties": { "activated": { "type": "boolean" } },
        "required": ["activated"]
      },
      "ActivationResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/ActivationResult" },
          "meta": { "$ref": "#/components/schemas/MetaDto" }
        },
        "required": ["data", "meta"]
      },
      "TenantStatus": {
        "type": "string",
        "enum": [
          "PENDING_ACTIVATION",
          "ACTIVE",
          "PAST_DUE_GRACE",
          "READ_ONLY",
          "SUSPENDED",
          "TERMINATED"
        ]
      },
      "TenantView": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "status": {
            "allOf": [{ "$ref": "#/components/schemas/TenantStatus" }]
          },
          "timezone": { "type": "string" }
        },
        "required": ["id", "name", "status", "timezone"]
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "manager",
          "academic_staff",
          "accountant",
          "teacher",
          "student",
          "guardian"
        ]
      },
      "RoleView": {
        "type": "object",
