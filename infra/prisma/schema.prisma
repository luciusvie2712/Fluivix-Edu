generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum TenantStatus {
  PENDING_ACTIVATION
  ACTIVE
  PAST_DUE_GRACE
  READ_ONLY
  SUSPENDED
  TERMINATED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum Role {
  owner
  manager
  academic_staff
  accountant
  teacher
  student
  guardian
}

model User {
  id           String               @id @default(uuid()) @db.Uuid
  email        String               @unique @db.VarChar(254)
  passwordHash String?              @map("password_hash")
  displayName  String               @map("display_name") @db.VarChar(150)
  status       UserStatus           @default(INVITED)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  memberships  Membership[]
  sessions     AuthSession[]
  resetTokens  PasswordResetToken[]

  @@map("users")
}

model Tenant {
  id                 String         @id @default(uuid()) @db.Uuid
  slug               String         @unique @db.VarChar(80)
  name               String         @db.VarChar(150)
  contactEmail       String?        @map("contact_email") @db.VarChar(254)
  timezone           String         @default("Asia/Ho_Chi_Minh") @db.VarChar(80)
  status             TenantStatus   @default(PENDING_ACTIVATION)
  subscriptionEndsAt DateTime       @map("subscription_ends_at") @db.Timestamptz
  graceUntil         DateTime       @map("grace_until") @db.Timestamptz
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  memberships        Membership[]
  students           Student[]
  invitations        Invitation[]
  subscriptions      Subscription[]

  @@map("tenants")
}

model Plan {
  id               String         @id @default(uuid()) @db.Uuid
  code             String         @unique @db.VarChar(40)
  name             String         @db.VarChar(150)
  monthlyPriceVnd  BigInt         @map("monthly_price_vnd")
  limitsJson       Json           @map("limits_json")
  featureFlagsJson Json           @map("feature_flags_json")
  status           String         @default("ACTIVE") @db.VarChar(20)
  subscriptions    Subscription[]

  @@map("plans")
}

model Subscription {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  planId     String              @map("plan_id") @db.Uuid
  status     String              @default("ACTIVE") @db.VarChar(20)
  startsAt   DateTime            @map("starts_at") @db.Timestamptz
  endsAt     DateTime            @map("ends_at") @db.Timestamptz
  graceUntil DateTime            @map("grace_until") @db.Timestamptz
  source     String              @default("PLATFORM_MANUAL") @db.VarChar(40)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan       Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  events     SubscriptionEvent[]

  @@unique([tenantId, id])
  @@index([tenantId, startsAt])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  type           String       @db.VarChar(40)
  effectiveAt    DateTime     @default(now()) @map("effective_at") @db.Timestamptz
  payload        Json
  actorId        String       @map("actor_id") @db.Uuid
  subscription   Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)

  @@map("subscription_events")
}

model Membership {
  id       String           @id @default(uuid()) @db.Uuid
  tenantId String           @map("tenant_id") @db.Uuid
  userId   String           @map("user_id") @db.Uuid
  status   MembershipStatus @default(INVITED)
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles    MembershipRole[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@map("tenant_memberships")
}

model MembershipRole {
  membershipId String     @map("membership_id") @db.Uuid
  role         Role
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@id([membershipId, role])
  @@map("membership_roles")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  clientType       String    @default("WEB") @map("client_type") @db.VarChar(10)
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  selectedTenantId String?   @map("selected_tenant_id") @db.Uuid
  selectedRole     Role?     @map("selected_role")
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("password_reset_tokens")
}

model Invitation {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  email     String    @db.VarChar(254)
  role      Role
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  invitedBy String    @map("invited_by") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("invitation_tokens")
}

model Student {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  userId        String?        @map("user_id") @db.Uuid
  studentCode   String         @map("student_code") @db.VarChar(40)
  fullName      String         @map("full_name") @db.VarChar(150)
  status        String         @default("ACTIVE") @db.VarChar(20)
  notesPrivate  String?        @map("notes_private") @db.VarChar(2000)
  dateOfBirth   DateTime?      @map("date_of_birth") @db.Date
  contactEmail  String?        @map("contact_email") @db.VarChar(254)
  contactPhone  String?        @map("contact_phone") @db.VarChar(30)
  enrolledAt    DateTime       @default(now()) @map("enrolled_at") @db.Date
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  guardianLinks GuardianLink[]

  @@unique([tenantId, id])
  @@unique([tenantId, studentCode])
  @@unique([tenantId, userId])
  @@index([tenantId, status, fullName])
  @@map("student_profiles")
}

model GuardianLink {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  studentId          String    @map("student_id") @db.Uuid
  guardianUserId     String    @map("guardian_user_id") @db.Uuid
  status             String    @default("PENDING") @db.VarChar(20)
  verifiedBy         String?   @map("verified_by") @db.Uuid
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz
  relationType       String    @default("GUARDIAN") @map("relation_type") @db.VarChar(20)
  verificationMethod String?   @map("verification_method") @db.VarChar(500)
  student            Student   @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, guardianUserId, status])
  @@map("guardian_student_links")
}

model Teacher {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  teacherCode String @map("teacher_code") @db.VarChar(40)
  fullName    String @map("full_name") @db.VarChar(150)
  status      String @default("ACTIVE") @db.VarChar(20)

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@unique([tenantId, teacherCode])
  @@map("teacher_profiles")
}

model EducationClass {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(150)
  capacity  Int
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  status    String   @default("ACTIVE") @db.VarChar(20)
  roomId String? @map("room_id") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("classes")
}

model ClassTeacher {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  classId       String    @map("class_id") @db.Uuid
  teacherId     String    @map("teacher_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  @@unique([tenantId, id])
  @@index([tenantId, classId, teacherId])
  @@map("class_teachers")
}

model Enrollment {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  joinedAt  DateTime  @map("joined_at") @db.Date
  leftAt    DateTime? @map("left_at") @db.Date
  status    String    @default("ACTIVE") @db.VarChar(20)

  @@unique([tenantId, id])
  @@unique([tenantId, id, classId, studentId])
  @@index([tenantId, studentId, classId])
  @@map("enrollments")
}

model ClassSession {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  classId       String    @map("class_id") @db.Uuid
  teacherId     String    @map("teacher_id") @db.Uuid
  scheduledDate DateTime  @map("scheduled_date") @db.Date
  startsAt      DateTime  @map("starts_at") @db.Timestamptz
  endsAt        DateTime  @map("ends_at") @db.Timestamptz
  status        String    @default("SCHEDULED") @db.VarChar(20)
  version       Int       @default(1)
  roomId String? @map("room_id") @db.Uuid
  changeCount Int @default(0) @map("change_count")
  cancelReason String? @map("cancel_reason") @db.VarChar(500)
  finalizedAt   DateTime? @map("finalized_at") @db.Timestamptz
  finalizedBy   String?   @map("finalized_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, id, classId])
  @@index([tenantId, teacherId, startsAt])
  @@map("class_sessions")
}
model Room {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @map("tenant_id") @db.Uuid
 code String @db.VarChar(40)
 name String @db.VarChar(150)
 capacity Int
 active Boolean @default(true)
 @@unique([tenantId,id])
 @@unique([tenantId,code])
 @@map("rooms")
}
model SessionChange {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @map("tenant_id") @db.Uuid
 sessionId String @map("session_id") @db.Uuid
 oldSnapshot Json @map("old_snapshot")
 newSnapshot Json @map("new_snapshot")
 reason String @db.VarChar(500)
 actorId String @map("actor_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
 @@map("session_changes")
}

model RosterRow {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  sessionId    String @map("session_id") @db.Uuid
  classId      String @map("class_id") @db.Uuid
  studentId    String @map("student_id") @db.Uuid
  enrollmentId String @map("enrollment_id") @db.Uuid
  displayName  String @map("display_name_snapshot") @db.VarChar(150)

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId, studentId])
  @@map("session_roster_snapshots")
}

model AttendanceRecord {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  status    String    @default("UNMARKED") @db.VarChar(30)
  note      String    @default("") @db.VarChar(500)
  markedBy  String?   @map("marked_by") @db.Uuid
  markedAt  DateTime? @map("marked_at") @db.Timestamptz

  @@unique([tenantId, sessionId, studentId])
  @@map("attendance_records")
}

model LessonReport {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  sessionId           String   @map("session_id") @db.Uuid
  lessonSummary       String   @map("lesson_summary") @db.VarChar(2000)
  homeworkText        String   @map("homework_text") @db.VarChar(2000)
  teacherNotesPrivate String   @map("teacher_notes_private") @db.VarChar(2000)
  updatedBy           String   @map("updated_by") @db.Uuid
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz
  version             Int      @default(1)

  @@unique([tenantId, sessionId])
  @@map("lesson_reports")
}

model Assessment {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  classId     String    @map("class_id") @db.Uuid
  title       String    @db.VarChar(150)
  heldAt      DateTime  @map("held_at") @db.Date
  maxScore    Decimal   @map("max_score") @db.Decimal(6, 2)
  status      String    @default("DRAFT") @db.VarChar(20)
  version     Int       @default(1)
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  createdBy   String    @map("created_by") @db.Uuid

  @@unique([tenantId, id])
  @@map("assessments")
}

model AssessmentResult {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  score        Decimal? @db.Decimal(6, 2)
  comment      String   @default("") @db.VarChar(2000)
  gradedBy     String   @map("graded_by") @db.Uuid
  gradedAt     DateTime @default(now()) @map("graded_at") @db.Timestamptz

  @@unique([tenantId, assessmentId, studentId])
  @@map("assessment_results")
}

model FeePlan {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  classId      String    @map("class_id") @db.Uuid
  name         String    @db.VarChar(150)
  billingModel String    @map("billing_model") @db.VarChar(10)
  amountVnd    BigInt    @map("amount_vnd")
  validFrom    DateTime  @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  status       String    @default("ACTIVE") @db.VarChar(20)

  @@unique([tenantId, id])
  @@map("fee_plans")
}

model InvoiceRun {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  feePlanId   String   @map("fee_plan_id") @db.Uuid
  periodKey   String   @map("period_key") @db.VarChar(20)
  requestHash String   @map("request_hash") @db.Char(64)
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, id])
  @@unique([tenantId, feePlanId, periodKey])
  @@map("invoice_runs")
}

model Invoice {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  invoiceNo      String   @map("invoice_no") @db.VarChar(60)
  issuedAt       DateTime @default(now()) @map("issued_at") @db.Timestamptz
  dueAt          DateTime @map("due_at") @db.Timestamptz
  totalAmountVnd BigInt   @map("total_amount_vnd")
  billingState   String   @default("ISSUED") @map("billing_state") @db.VarChar(10)
  voidReason     String?  @map("void_reason") @db.VarChar(500)
  createdBy      String   @map("created_by") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, id, studentId])
  @@unique([tenantId, invoiceNo])
  @@unique([tenantId, runId, studentId])
  @@index([tenantId, studentId, dueAt])
  @@map("invoices")
}

model InvoiceItem {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  invoiceId      String @map("invoice_id") @db.Uuid
  feePlanId      String @map("fee_plan_id") @db.Uuid
  description    String @db.VarChar(300)
  totalAmountVnd BigInt @map("total_amount_vnd")

  @@map("invoice_items")
}

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  studentId         String   @map("student_id") @db.Uuid
  receiptNo         String   @map("receipt_no") @db.VarChar(60)
  method            String   @db.VarChar(20)
  receivedAmountVnd BigInt   @map("received_amount_vnd")
  receivedAt        DateTime @map("received_at") @db.Timestamptz
  externalReference String?  @map("external_reference") @db.VarChar(150)
  receivedBy        String   @map("received_by") @db.Uuid
  status            String   @default("CONFIRMED") @db.VarChar(20)

  @@unique([tenantId, id])
  @@unique([tenantId, id, studentId])
  @@unique([tenantId, receiptNo])
  @@index([tenantId, studentId, receivedAt])
  @@map("payments")
}

model PaymentAllocation {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  amountVnd BigInt @map("amount_vnd")

  @@unique([tenantId, paymentId, invoiceId])
  @@index([tenantId, invoiceId])
  @@map("payment_allocations")
}

model PaymentReversal {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  reason     String   @db.VarChar(500)
  approvedBy String   @map("approved_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, paymentId])
  @@map("payment_reversals")
}

model IdempotencyRecord {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  operation   String @db.VarChar(40)
  key         String @db.VarChar(100)
  requestHash String @map("request_hash") @db.Char(64)
  response    Json

  @@unique([tenantId, userId, operation, key])
  @@map("idempotency_keys")
}

model NotificationPreference {
  tenantId    String  @map("tenant_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  pushEnabled Boolean @default(false) @map("push_enabled")
  attendance  Boolean @default(true)
  grades      Boolean @default(true)
  finance     Boolean @default(true)
  schedule    Boolean @default(true)

  @@id([tenantId, userId])
  @@map("notification_preferences")
}

model DevicePushToken {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  familyId       String @map("family_id") @db.Uuid
  tokenHash      String @unique @map("token_hash") @db.Char(64)
  tokenEncrypted String @map("token_encrypted")
  platform       String @db.VarChar(10)
  status         String @default("ACTIVE") @db.VarChar(20)

  @@index([userId, familyId, status])
  @@map("device_push_tokens")
}

model Notification {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  recipientUserId  String    @map("recipient_user_id") @db.Uuid
  recipientRole    Role      @map("recipient_role")
  subjectStudentId String?   @map("subject_student_id") @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  type             String    @db.VarChar(80)
  entityType       String    @map("entity_type") @db.VarChar(30)
  entityId         String    @map("entity_id") @db.Uuid
  readAt           DateTime? @map("read_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, id])
  @@unique([eventId, recipientUserId, recipientRole, subjectStudentId])
  @@index([tenantId, recipientUserId, recipientRole, createdAt])
  @@map("notifications")
}

model PushDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  deviceId       String    @map("device_id") @db.Uuid
  status         String    @default("PENDING") @db.VarChar(20)
  attempts       Int       @default(0)
  providerRef    String?   @map("provider_ref") @db.VarChar(150)
  lastAttemptAt  DateTime? @map("last_attempt_at") @db.Timestamptz

  @@unique([notificationId, deviceId])
  @@map("notification_deliveries")
}

model PrivacyConsent {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  subjectStudentId String?   @map("subject_student_id") @db.Uuid
  consentingUserId String    @map("consenting_user_id") @db.Uuid
  policyVersion    String    @map("policy_version") @db.VarChar(100)
  purposeCode      String    @map("purpose_code") @db.VarChar(40)
  legalBasis       String    @map("legal_basis") @db.VarChar(40)
  granted          Boolean
  capturedAt       DateTime  @default(now()) @map("captured_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz

  @@index([tenantId, consentingUserId, subjectStudentId, purposeCode])
  @@map("privacy_consents")
}

model DataSubjectRequest {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  requesterUserId  String   @map("requester_user_id") @db.Uuid
  subjectStudentId String?  @map("subject_student_id") @db.Uuid
  type             String   @db.VarChar(20)
  status           String   @default("RECEIVED") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, id])
  @@map("data_subject_requests")
}

model GradeChange {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  version      Int
  beforeValue  Json     @map("before_value")
  afterValue   Json     @map("after_value")
  actorId      String   @map("actor_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("grade_change_events")
}

model LessonRevision {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  sessionId           String   @map("session_id") @db.Uuid
  version             Int
  lessonSummary       String   @map("lesson_summary") @db.VarChar(2000)
  homeworkText        String   @map("homework_text") @db.VarChar(2000)
  teacherNotesPrivate String   @map("teacher_notes_private") @db.VarChar(2000)
  actorId             String   @map("actor_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, sessionId, version])
  @@map("lesson_report_revisions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  reason      String?  @db.VarChar(500)
  resourceId  String   @map("resource_id") @db.VarChar(80)
  traceId     String   @map("trace_id") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String?       @map("tenant_id") @db.Uuid
  eventType    String        @map("event_type") @db.VarChar(80)
  aggregateId  String        @map("aggregate_id") @db.Uuid
  eventVersion Int           @map("event_version")
  payload      Json
  processedAt  DateTime?     @map("processed_at") @db.Timestamptz
  attempts     Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  mailDelivery MailDelivery?

  @@unique([eventType, aggregateId, eventVersion])
  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

model MailDelivery {
  eventId String      @id @map("event_id") @db.Uuid
  status  String      @default("PENDING") @db.VarChar(20)
  sentAt  DateTime?   @map("sent_at") @db.Timestamptz
  event   OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@map("mail_deliveries")
}

model PlatformUser {
  id             String              @id @default(uuid()) @db.Uuid
  email          String              @unique @db.VarChar(254)
  displayName    String              @map("display_name") @db.VarChar(150)
  passwordHash   String              @map("password_hash")
  active         Boolean             @default(true)
  mfaSecret      String?             @map("mfa_secret")
  lastTotpStep   BigInt              @default(-1) @map("last_totp_step")
  recoveryHashes String[]            @default([]) @map("recovery_hashes")
  challenges     PlatformChallenge[]
  sessions       PlatformSession[]

  @@map("platform_users")
}

model PlatformChallenge {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  tokenHash     String       @unique @map("token_hash") @db.Char(64)
  pendingSecret String?      @map("pending_secret")
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz
  usedAt        DateTime?    @map("used_at") @db.Timestamptz
  attempts      Int          @default(0)
  user          PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("platform_challenges")
}

model PlatformSession {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  familyId   String       @map("family_id") @db.Uuid
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz
  consumedAt DateTime?    @map("consumed_at") @db.Timestamptz
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz
  user       PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([familyId])
  @@map("platform_sessions")
}

model PlatformAudit {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  reason     String?  @db.VarChar(500)
  resourceId String   @map("resource_id") @db.VarChar(80)
  traceId    String   @map("trace_id") @db.VarChar(80)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@map("platform_audit")
}
