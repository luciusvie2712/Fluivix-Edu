# Synthetic local development only. Supply independent secrets for other environments.
NODE_ENV=development
API_HOST=127.0.0.1
DATABASE_URL=postgresql://fluivix:local-development-only@127.0.0.1:5432/fluivixedu
TEST_DATABASE_URL=postgresql://fluivix:local-development-only@127.0.0.1:5432/fluivixedu_test
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=http://localhost:3000
PLATFORM_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Generate at least 32 random bytes, do not use a checked-in signing secret.
JWT_SECRET=
PLATFORM_JWT_SECRET=
PLATFORM_MFA_KEY=
OUTBOX_TOKEN_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=noreply@fluivixedu.test
MAIL_PROVIDER=mailpit
RESEND_API_KEY=
QUEUE_PREFIX=fluivixedu
PUSH_PROVIDER=disabled
# Daily idempotent rolling60day schedule jobs; disable only in controlled tests/maintenance.
SCHEDULE_GENERATION_ENABLED=true
EXPO_ACCESS_TOKEN=
PRIVACY_POLICY_VERSION=
PRIVACY_NOTICE_URL=
# Dedicated server-only 32-byte hex encryption key and opaque key identifier.
# Missing configuration blocks export fulfillment; never use EXPO_PUBLIC_*.
PRIVACY_EXPORT_KEY=
PRIVACY_EXPORT_KEY_ID=
# Technical temporary-file lifetime (1..1440 minutes), not legal retention.
PRIVACY_EXPORT_TTL_MINUTES=30
# Leave profile redaction disabled until the operator records reviewed approval.
PRIVACY_ERASURE_POLICY_VERSION=
PRIVACY_ERASURE_APPROVAL_REF=
PRIVACY_ERASURE_FIELDS=
# Public native build configuration, never place private keys in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_EAS_PROJECT_ID=
# Development seed credentials must be supplied explicitly, never used in production.
SEED_PASSWORD=
